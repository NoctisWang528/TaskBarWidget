<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <!-- The first-frame wash is intentionally almost transparent so the
             system Mica material remains the visible card surface. -->
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="CardWindowSurfaceBrush" Color="#0AFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="CardWindowSurfaceBrush" Color="#0AFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="CardWindowSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <!-- Keep ThemeResource expressions on the actual styled property, so changing
         the root theme updates existing editors without rebuilding their drafts. -->
    <!-- The default menu has a transparent fill over a separate Acrylic backdrop.
         Use an opaque themed surface so popup text and its background cannot diverge. -->
    <Style x:Key="CardMenuPresenter" TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource DefaultMenuFlyoutPresenterStyle}">
        <Setter Property="SystemBackdrop" Value="{x:Null}" />
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorFlyoutBrush}" />
    </Style>
    <Style x:Key="CardTextPrimary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>
    <Style x:Key="CardTextSecondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style x:Key="SettingsSurface" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsDivider" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsStroke" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsSourceSurface" TargetType="Border" BasedOn="{StaticResource SettingsStroke}">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsRule" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsPane" TargetType="ScrollViewer" BasedOn="{StaticResource DefaultScrollViewerStyle}">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsReorderDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <Style x:Key="SettingsDragGhost" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrongStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsInsertion" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
    </Style>
    <Style x:Key="SettingsDropPlaceholder" TargetType="Border" BasedOn="{StaticResource SettingsStroke}">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorSecondaryBrush}" />
    </Style>
    <!-- Card windows are shown before their first composition frame is
         committed; a themed fill keeps that surface from flashing the raw
         window client area, while Mica stays visible outside the card. -->
    <Style x:Key="CardWindowSurface" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardWindowSurfaceBrush}" />
    </Style>
</ResourceDictionary>
